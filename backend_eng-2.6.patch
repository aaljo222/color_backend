+"""eng-2.6 — 그리기 전 후보 색 · 그림 뒤 4색 ⊂ 후보 · 감정 가중 면적 · 감정-정서 대조 · 칩별 색-감정 근거 · 변형 번호."""
+import numpy as np
+import pytest
+from PIL import Image
+
+from core import image_first as imf
