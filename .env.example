# ── 실행 모드 ──
# prod 이면 /docs 비활성 + Supabase/토큰 검증 수단 없으면 부팅 실패
APP_ENV=dev
# 비우면 GEMINI_API_KEY 유무로 자동(gemini|stub)
LLM_MODE=
# ngram | embedding | supabase
RETRIEVER=ngram
# 비우면 검색기별 기본값 (scripts/eval_tau.py 로 정할 것)
RETRIEVAL_TAU=

# ── AI ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ── Supabase (서버 전용 — service_role 은 절대 프론트에 두지 말 것) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Supabase JWT Secret (HS256). 비대칭 키 프로젝트면 비워 두면 원격 검증
JWT_SECRET_KEY=
SPECIMEN_BUCKET=specimens
SIGNED_URL_TTL=600

# ── 보안 ──
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MEMORY_ENC_KEY=
CORS_ORIGINS=https://mac.ai.kr,https://www.mac.ai.kr
UA_BLOCK=1
CF_ORIGIN_SECRET=
CF_GUARD_ENFORCE=0

# ── 정책 ──
FREE_CREDITS=3
GUEST_DAILY_LIMIT=2
VERIFY_DE_MAX=5.0
VERIFY_RATIO_MAX=0.05
VERIFY_MAX_ATTEMPTS=3

# ── 메일 (기존 Resend) ──
RESEND_API_KEY=
MAIL_FROM=MaC <mac@mac.ai.kr>
