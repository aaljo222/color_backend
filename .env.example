# ── 실행 모드 ──
# prod 이면 /docs 비활성 + Supabase/토큰 검증 수단 없으면 부팅 실패
APP_ENV=dev
# 비우면 ANTHROPIC_API_KEY 유무로 자동(claude|stub)
LLM_MODE=
# ngram | embedding | supabase
RETRIEVER=ngram
# 비우면 검색기별 기본값 (scripts/eval_tau.py 로 정할 것)
RETRIEVAL_TAU=

# ── AI (Claude 통일) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# 선택: 임베딩 검색(RETRIEVER=embedding|supabase)용. Claude API 에는 임베딩이 없어 별도 제공자
GEMINI_API_KEY=
# ── 그림 먼저 (eng-2.0) ── palette(기본, eng-1.2) | image_first
ENGINE_MODE=palette
# PAINTER = gemini | claude_scene | stub  (비우면 GEMINI 키 → gemini, ANTHROPIC 키 → claude_scene, 없으면 stub)
PAINTER=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
IMAGE_MAX_ATTEMPTS=2
IMAGE_COVER_MIN=0.80
# 정서 범위 심사: hard = 범위 밖이면 다시 그림(기본) / soft = 참고 표시만, 합격은 대표도(80%)로만 판정
IMAGE_AFFECT_GATE=soft
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ── Supabase (서버 전용 — service_role 은 절대 프론트에 두지 말 것) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Supabase JWT Secret (HS256). 비대칭 키 프로젝트면 비워 두면 원격 검증
JWT_SECRET_KEY=
SPECIMEN_BUCKET=specimens
SIGNED_URL_TTL=600

# ── 보안 ──
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MEMORY_ENC_KEY=
# 프론트(Vercel) 주소를 쉼표로. 예: https://color-ivory-pi.vercel.app,https://mac.ai.kr
CORS_ORIGINS=https://mac.ai.kr,https://www.mac.ai.kr
UA_BLOCK=1
CF_ORIGIN_SECRET=
CF_GUARD_ENFORCE=0

# ── 정책 ──
FREE_CREDITS=3
GUEST_DAILY_LIMIT=2
VERIFY_DE_MAX=5.0
VERIFY_RATIO_MAX=0.05
VERIFY_MAX_ATTEMPTS=3

# ── 메일 (기존 Resend) ──
RESEND_API_KEY=
MAIL_FROM=MaC <mac@mac.ai.kr>

# ── Color Oracle (/api/palette) ──
# 처음 보는 장면을 추상화할 때 쓰는 모델 (기본 CLAUDE_MODEL)
ORACLE_MODEL=

# 색 문장 '비슷한 문장 추천' (oracle/similar.py) — Anthropic 은 자체 임베딩 모델이 없어 Voyage AI 를 쓴다
# VOYAGE_API_KEY=            # 있으면 임베딩(뜻 기준) 추천, 없으면 글자 n-gram 추천
# VOYAGE_MODEL=voyage-4      # voyage-4-lite(저렴) · voyage-4-large(품질)
# SIMILAR_DIM=1024           # DB vector(1024) 와 같아야 한다
# SIMILAR_MIN=               # 기준선 (기본 ngram 0.35 · embedding 0.50) → scripts/eval_similar.py 로 다시 정하기
# 켠 뒤: schema.sql 11-1 실행 → python scripts/embed_prompts.py
# ── 코퍼스 RAG (eng-2.2) — data/corpus/*.jsonl. 끄려면 CORPUS_RAG=0 ──
CORPUS_RAG=1
# auto(임베딩 파일·키가 맞으면 embedding, 아니면 ngram) | ngram | embedding
CORPUS_METHOD=auto
# 비우면 ngram 0.35 · embedding 0.55(잠정) → scripts/eval_rag.py --sweep 으로 정할 것
CORPUS_TAU=
# 임베딩을 켜려면: VOYAGE_API_KEY 등록(본인 키) → python scripts/build_corpus_embeddings.py → data/corpus_embeddings.json
# ── 문장 고정 (eng-2.1) — 같은 문장 = 같은 해시·HEX·색 이름. sql/schema.sql 12) 실행 필요 ──
SENTENCE_LOCK=1
# eng-2.3 같은 문장급(조사·어미·시제·어순만 다름)도 같은 표본. 0 이면 정확히 같은 문장만
SENTENCE_CLASS=1
# 1 이면 LLM 요약(memory_summary)도 고정값에 저장 (기본 0 = 원문·요약 저장 안 함)
LOCK_KEEP_SUMMARY=0
